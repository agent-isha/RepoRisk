# Frontend settings. Copy to .env.local (git-ignored) to override.

# Leave empty to call the API on the same origin. In development, Vite proxies
# /api and /health to REPORISK_API_PROXY, which keeps the session cookie first-party.
VITE_API_BASE_URL=

# Where the Vite dev server forwards /api requests.
REPORISK_API_PROXY=http://127.0.0.1:8000
