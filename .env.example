# RepoRisk API configuration. Copy to .env (git-ignored) and edit.
# The API reads .env from the directory you start it in; real environment
# variables take precedence. Never commit .env or put passwords here:
# accounts are created with `python -m reporisk.api.users create EMAIL`.

# "development" for local work over plain HTTP; "production" (the default when
# unset) forces Secure cookies and disables the interactive /docs.
REPORISK_ENV=development

# Local development only: allow the session cookie over http://localhost.
# Ignored in production, where cookies are always Secure.
REPORISK_COOKIE_SECURE=false

# Optional: pre-approved local repositories, separated by ":" (";" on Windows).
# Not needed for public GitHub URLs, which users enter in the dashboard.
# REPORISK_REPOS=/absolute/path/to/a/git/repository

# GitHub URL analysis: temporary clone location and limits (defaults shown).
# REPORISK_CLONE_DIR=            # default: the system temp directory
# REPORISK_CLONE_TIMEOUT=180     # seconds
# REPORISK_MAX_REPO_MB=500
# REPORISK_MAX_COMMITS=20000     # bounds analysis time
# REPORISK_MAX_QUEUED=3          # analyses queued or running at once

# Account and session database (SQLite). Keep it outside the web root and back it up.
REPORISK_DB_PATH=instance/reporisk.sqlite3

# Generated datasets and model outputs.
REPORISK_DATA_DIR=output/api

# Session lifetime in hours.
REPORISK_SESSION_HOURS=12

# Browser origins allowed to call the API (only needed if the frontend is served
# from a different origin than the API).
REPORISK_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Production: serve the built frontend (cd frontend && npm run build) from the API.
# REPORISK_FRONTEND_DIST=frontend/dist
